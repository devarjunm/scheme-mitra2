# Local development only. Copy to .env and change secrets if you expose the service.
APP_ENV=development
PORT=8080
HOST=0.0.0.0

# docker-compose.yml supplies db/redis hostnames. For direct Python use, point these
# at a local PostgreSQL and Redis instance, or set DATABASE_URL to a SQLite URL.
DATABASE_URL=postgresql+psycopg://postgres:8010084593@localhost:2157/scheme_mitra
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# These values are suitable only for local development.
JWT_SECRET=local-only-change-this-secret-before-any-shared-demo-0123456789
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
DEMO_MODE=true
SEED_SCHEMES=true
TRUSTED_HOSTS=localhost,127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1,::1
CORS_ORIGINS=

# Optional: creates or promotes a SUPER_ADMIN on startup. Use only for local testing;
# for production use a secret manager, then remove the bootstrap secret after first use.
ADMIN_EMAIL=arjunmahale001@gmail.com
ADMIN_PASSWORD=1234

